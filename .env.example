# No environment file is required to start PropertyChecked on this PC.
PORT=3000
# Old/manual-record postcode CENTROID lookup. The new Create 3D model page
# has its own explicit public-data consent for each search.
POSTCODE_LOOKUP_ENABLED=false
# Optional GPT height suggestions. Keep the real key only in .env on your PC.
# Never put it in a browser file, source control or chat. API charges may apply.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional trusted HTTPS Overpass endpoint. The default is a shared public
# instance for occasional local tests, NOT a production customer backend.
# OVERPASS_API_URL=https://your-licensed-or-self-hosted-service/api/interpreter
# Optional ONE backup for a custom service. Set to none to disable failover.
# Default pair (when neither is configured): overpass-api.de then overpass.private.coffee.
# Custom OVERPASS_API_URL disables public fallback unless you set this explicitly.
# OVERPASS_FALLBACK_URL=https://your-approved-backup/api/interpreter
# Optional LAN passphrase. Leave unset for a new code at every server start.
# LOCAL_ACCESS_CODE=replace-with-a-long-private-passphrase
# Optional local database/upload directory. Defaults to .data/ in this folder.
# PROPERTYCHECKED_DATA_DIR=
