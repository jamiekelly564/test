{
  "name": "propertychecked-platform",
  "version": "0.11.0",
  "private": true,
  "description": "PropertyChecked local development starter: 3D buildings, capture packages and survey workflow.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --watch apps/api/preview-server.mjs",
    "dev:lan": "node --watch apps/api/preview-server.mjs --lan",
    "start": "node apps/api/preview-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "github:publish": "node scripts/publish-github.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "predev": "node scripts/doctor.mjs",
    "predev:lan": "node scripts/doctor.mjs",
    "prestart": "node scripts/doctor.mjs",
    "check:data": "node --env-file-if-exists=.env scripts/check-data.mjs",
    "setup:ai": "node --env-file-if-exists=.env scripts/setup-ai.mjs",
    "check:map": "node --env-file-if-exists=.env scripts/check-map.mjs"
  }
}
